{
  "format": 2,
  "$schema": "https://example.test/notifications.schema.json",
  "minVersion": "0.1.0+settings",
  "unattendedOnly": true,
  "slack": {
    "when": "failed",
    "label": "release checks"
  },
  "telegram": {
    "chat": "-1001234567890",
    "when": "every",
    "label": { "team": "QA" }
  },
  "email": {
    "server": "smtp.example.test",
    "port": 587,
    "security": "startTls",
    "user": "tests@example.test",
    "from": "tests@example.test",
    "to": ["qa@example.test"],
    "when": "changed"
  },
  "review": { "labels": ["nightly", "release"] }
}
