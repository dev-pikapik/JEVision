  "add_blocks": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "string"
        },
        "atStart": {
          "type": "boolean"
        },
        "blocks": {
          "items": {
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "edge": {
          "pattern": "^(next|then|else|body|elseIf[1-9][0-9]*)$",
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "blocks"
      ],
      "type": "object"
    }
  },
