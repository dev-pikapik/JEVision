    "Theirs: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С сервера: %@"
          }
        }
      }
    },
    "Theirs: Removed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С сервера: удалено"
          }
        }
      }
    },
    "Then choose a block with the arrow keys and press Return." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
