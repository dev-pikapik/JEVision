      }
    },
    "Installed. The same engine as the app, without a window." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установлена. Тот же движок, что в приложении, только без окна."
          }
        }
      }
    },
    "Installing GitHub CLI…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
