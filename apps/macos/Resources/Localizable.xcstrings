    "“%@” can’t be a branch name. Use letters, numbers and dashes, without spaces." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не подходит для имени ветки. Используйте буквы, цифры и дефисы, без пробелов."
          }
        }
      }
    },
    "“%@” can’t be a value name: use Latin letters, digits and _, not starting with a digit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не подходит как имя значения: используйте латинские буквы, цифры и _, и не начинайте с цифры."
          }
        }
      }
    },
