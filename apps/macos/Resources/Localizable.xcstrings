    "GitHub CLI is signed in as %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI вошёл как %@"
          }
        }
      }
    },
    "GitHub CLI isn’t installed. Install it from cli.github.com, then run “gh auth login” in Terminal." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub CLI не установлен. Установите его с cli.github.com, затем выполните «gh auth login» в Терминале."
          }
        }
      }
    },
    "GitHub didn’t accept the OAuth app’s Client ID. Check it, and that device flow is turned on in the app’s settings on GitHub." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub не принял Client ID OAuth-приложения. Проверьте его и включён ли Device flow в настройках приложения на GitHub."
          }
        }
      }
    },
    "GitHub didn’t answer for this one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub не ответил по этой задаче."
