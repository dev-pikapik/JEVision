    "data.rowLength" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "line %@ has %@ values, but the first line names %@ columns"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "в строке %1$@ значений: %2$@, а в первой строке названо столбцов: %3$@"
          }
