    },
    "check.path.absolute" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” points to a place on this computer only, so the test won’t find the file anywhere else. Put the file in the project and choose it again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» указывает на место только на этом компьютере, поэтому на другом тест файл не найдёт. Положите файл в проект и выберите его заново."
          }
        }
      }
    },
    "check.path.backslash" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” separates folders with \\, which works only on Windows. Write it with / instead: “%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «%@» папки разделены знаком \\, а так работает только в Windows. Напишите через /: «%@»."
          }
        }
      }
    },
    "check.path.case" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The test names “%@”, but the file is called “%@”. A Mac treats capital and small letters alike, but Linux and many CI servers don’t. Write the name exactly as the file is called."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тесте написано «%@», а файл называется «%@». Mac не различает заглавные и строчные буквы, а Linux и многие CI-серверы различают. Напишите имя точно так, как называется файл."
          }
        }
      }
    },
    "check.path.link" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is a link to a file outside the project, so the file itself won’t come along when the project is copied or run on CI. Put the file itself in the project."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — ссылка на файл вне проекта, поэтому сам файл не попадёт в копию проекта и в CI. Положите в проект сам файл."
          }
        }
      }
    },
    "check.path.outside" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” leads out of the project folder, so the file won’t come along when the project is copied or run on CI. Move the file into the project and choose it again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ведёт за пределы папки проекта, поэтому файл не попадёт в копию проекта и в CI. Перенесите файл в проект и выберите его заново."
          }
        }
      }
    },
