    "data.rows.backwards" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ends before it starts; write the smaller row first, like %lld-%lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» заканчивается раньше, чем начинается: сначала напишите меньшую строку, например %2$lld-%3$lld."
          }
        }
      }
    },
    "data.rows.invalid" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn’t a choice of data rows; write all, a row like 2 or a range like 2-4."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не выбор строк данных: напишите all, одну строку, например 2, или диапазон, например 2-4."
          }
        }
      }
    },
    "data.strayQuote" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "line %@ has a quote in the middle of a value; put the whole value in quotes and double the quote inside"
