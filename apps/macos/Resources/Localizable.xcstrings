      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало работы"
          }
        }
      }
    },
    "Git and GitHub" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git и GitHub"
          }
        }
      }
    },
    "Git doesn’t track this project, so there is no history to show." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git не ведёт этот проект, поэтому истории нет."
          }
        }
      }
    },
    "Git isn’t installed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git не установлен"
          }
        }
      }
    },
    "Git isn’t installed on this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac не установлен git."
          }
        }
      }
    },
    "Git keeps every version of your tests, so you can see what changed and go back to any version." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git хранит каждую версию тестов: видно, что изменилось, и можно вернуться к любой версии."
          }
        }
      }
    },
    "Git saves your name and email with each commit. They’re remembered for all your projects." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git сохраняет имя и email в каждом коммите. Они запомнятся для всех ваших проектов."
          }
        }
      }
    },
