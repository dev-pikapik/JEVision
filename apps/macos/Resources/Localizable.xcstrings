    "The project has none" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В проекте их нет"
          }
        }
      }
    },
    "The pull request contains only what you write. JEVision adds nothing to it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В пул-реквесте только то, что написали вы. JEVision ничего не добавляет."
          }
        }
      }
    },
    "The recording couldn’t be added to the test: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось добавить запись в тест: %@"
          }
        }
      }
    },
    "The reference image is outside the project, so JEVision doesn’t change it. Choose a picture inside the project in the inspector first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эталонная картинка лежит вне проекта, поэтому JEVision её не меняет. Сначала выберите в инспекторе картинку внутри проекта."
          }
        }
      }
    },
    "The repository wasn’t found on the server, or your account can’t open it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Репозиторий не найден на сервере, или у вашей учётной записи нет к нему доступа."
          }
        }
      }
    },
    "The run pauses before this block. Click to remove." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогон встанет на паузу перед этим блоком. Нажмите, чтобы убрать."
          }
        }
      }
    },
    "The run pauses here" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь прогон встанет на паузу"
          }
        }
      }
    },
    "The same engine as the app, without a window." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот же движок, что в приложении, только без окна."
          }
        }
      }
    },
    "The same part of %@ changed here and on the server, so the changes can’t be combined automatically. Nothing was changed; your files are as they were." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна и та же часть %@ изменилась и здесь, и на сервере, поэтому изменения не объединить автоматически. Ничего не изменено: файлы остались как были."
          }
        }
      }
    },
    "The screen is locked. Unlock it and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран заблокирован. Разблокируйте его и попробуйте снова."
          }
        }
      }
    },
    "The screen over the reference image" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран поверх эталона"
          }
        }
      }
    },
    "The screen stops changing" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экран перестанет меняться"
          }
        }
      }
    },
    "The server didn’t accept your sign-in. Sign in with GitHub CLI (gh auth login) or set up an SSH key, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер не принял вход. Войдите через GitHub CLI (gh auth login) или настройте SSH-ключ и попробуйте снова."
          }
        }
      }
    },
    "The server has changes you don’t have yet. Pull first, then push again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сервере есть изменения, которых у вас ещё нет. Сначала получите их, затем отправьте снова."
          }
        }
      }
    },
    "The share of pixels that must look the same as in the reference. Around %@ lets small differences through, like smoothed text or a blinking cursor; %@ wants every pixel to match." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля пикселей, которые должны выглядеть как в эталоне. Около %@ пропускает мелкие отличия вроде сглаженного текста или мигающего курсора; %@ требует совпадения каждого пикселя."
          }
        }
      }
    },
    "The table wasn’t saved: %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таблица не сохранена: %@."
          }
        }
      }
    },
    "The test couldn’t start: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест не удалось запустить: %@"
          }
        }
      }
    },
    "The test failed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест провален."
          }
        }
      }
    },
    "The test goes the Yes way when the screen matches the image, and the No way when it doesn’t." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест идёт по ветке «Да», если экран совпадает с картинкой, и по ветке «Нет», если не совпадает."
          }
        }
      }
    },
    "The test has no blocks yet." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тесте пока нет блоков."
          }
        }
      }
    },
    "The test has problems. They’re marked on the blocks; fix them and run again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тесте есть ошибки. Они отмечены на блоках — исправьте их и запустите снова."
          }
        }
      }
    },
    "The test hasn’t been run yet" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест ещё ни разу не запускали"
          }
        }
      }
    },
    "The test is saved as a file in the open project." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тест сохранится файлом в открытом проекте."
          }
        }
      }
    },
    "The test reads these values from an environment, and the project has none yet." : {
      "localizations" : {
        "ru" : {
