    "Install a Block" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка блока"
          }
        }
      }
    },
    "Install a block only from people you trust. These steps do more than click and type in the app under test." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устанавливайте блоки только от тех, кому доверяете. Эти шаги делают больше, чем нажимают и вводят текст в проверяемом приложении."
          }
        }
      }
    },
    "Installed from a file" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
