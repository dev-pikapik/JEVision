          }
        }
      }
    },
    "Test any Mac app the way a person would: click, type, look. A test is a flowchart you can read — no code." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тестируйте любое приложение на Mac так, как это делает человек: кликнуть, ввести, посмотреть. Тест — понятная блок-схема, без кода."
          }
        }
      }
    },
    "Test details" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карточка теста"
          }
        }
      }
