    "The pictures are the same" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Картинки одинаковые"
          }
        }
      }
    },
    "The project folder isn’t inside a git repository, so there is nowhere to add the workflow. Copy it to use it elsewhere." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
