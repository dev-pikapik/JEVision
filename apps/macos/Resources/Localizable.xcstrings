            "state" : "translated",
            "value" : "Сервер ответил ошибкой %1$u: %2$@"
          }
        }
      }
    },
    "The server didn’t accept the access token. Set it again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
