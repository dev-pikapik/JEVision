{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ To put a test in quarantine, choose Quarantine… in its menu in the sidebar. The settings are saved in %@ in the project folder." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Чтобы отправить тест в карантин, выберите «В карантин…» в его меню в боковой панели. Настройки сохраняются в файле %2$@ в папке проекта."
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и ещё %lld"
          }
        }
      }
    },
    "%@ at %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ в %2$@"
          }
        }
      }
    },
    "%@ can’t be read: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся прочитать %1$@: %2$@"
          }
        }
      }
    },
    "%@ can’t be saved: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удаётся сохранить %1$@: %2$@"
          }
        }
      }
    },
    "%@ finished. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ finished. %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: готово. %2$@"
          }
        }
      }
    },
    "%@ has changes that aren’t committed and would be replaced. Commit them first, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ есть незакоммиченные изменения, и они были бы заменены. Сначала закоммитьте их, затем попробуйте снова."
          }
        }
      }
    },
    "%@ has no open window. Open it on the screen the test checks, then try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ нет открытого окна. Откройте его на экране, который проверяет тест, и попробуйте снова."
          }
        }
      }
    },
    "%@ in “%@”. The test will use the mouse and keyboard of this Mac until it ends." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ в «%2$@». Пока тест идёт, он управляет мышью и клавиатурой этого Mac."
          }
        }
      }
    },
    "%@ is another program" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — другая программа"
          }
        }
      }
    },
    "%@ is version %@ from another copy of JEVision" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
