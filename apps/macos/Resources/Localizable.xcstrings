{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nRemove their lines from .gitattributes yourself, or choose Edit › Undo to put the files back and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nУдалите их строки из .gitattributes вручную или выберите «Правка › Отменить», чтобы вернуть файлы, и попробуйте снова."
          }
        }
      }
    },
    "%@ %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ = %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ = %2$@"
          }
        }
      }
    },
    "%@ Colleagues who open this test will need this version of JEVision or newer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Коллегам, которые откроют этот тест, понадобится эта версия JEVision или новее."
          }
        }
      }
    },
    "%@ To put a test in quarantine, choose Quarantine… in its menu in the sidebar. The settings are saved in %@ in the project folder." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Чтобы отправить тест в карантин, выберите «В карантин…» в его меню в боковой панели. Настройки сохраняются в файле %2$@ в папке проекта."
          }
        }
      }
    },
