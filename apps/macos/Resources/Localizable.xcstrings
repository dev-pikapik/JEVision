    "With Example" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С примером"
          }
        }
      }
    },
    "With ⌘ held, most apps zoom instead of scrolling." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если держать ⌘, большинство приложений меняют масштаб вместо прокрутки."
          }
        }
      }
    },
    "Without a provider, checks compare pictures only and send nothing anywhere." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без провайдера проверки сравнивают только картинки и ничего никуда не отправляют."
          }
        }
      }
    },
    "Without an administrator’s password" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без пароля администратора"
          }
        }
      }
    },
    "Without an element, the wheel turns over the middle of the window." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без элемента колесо крутится над серединой окна."
          }
        }
      }
    },
    "Without them, macOS won’t let JEVision see other apps or click in them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без них macOS не даст JEVision видеть другие приложения и нажимать в них."
          }
        }
      }
    },
    "Workflow Added" : {
      "localizations" : {
        "ru" : {
