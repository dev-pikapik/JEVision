          }
        }
      }
    },
    "The project folder isn’t inside a git repository." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка проекта не находится внутри git-репозитория."
          }
        }
      }
    },
    "The project has no environment yet. Add one to give the test its values." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В проекте ещё нет окружения. Добавьте его, чтобы у теста были значения."
          }
        }
      }
    },
    "The project has no folders with tests." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В проекте нет папок с тестами."
          }
        }
      }
    },
    "The project has none" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В проекте их нет"
          }
        }
      }
    },
    "The pull request contains only what you write. JEVision adds nothing to it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В пул-реквесте только то, что написали вы. JEVision ничего не добавляет."
          }
        }
      }
    },
    "The recording couldn’t be added to the test: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось добавить запись в тест: %@"
          }
        }
      }
    },
    "The red outline shows where JEV found the element." : {
      "localizations" : {
        "ru" : {
