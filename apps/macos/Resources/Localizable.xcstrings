    "yesterday at %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "вчера в %@"
          }
        }
      }
    },
    "“%@” can’t be a branch name. Use letters, numbers and dashes, without spaces." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не подходит для имени ветки. Используйте буквы, цифры и дефисы, без пробелов."
          }
        }
      }
    },
    "“%@” can’t be a value name: use Latin letters, digits and _, not starting with a digit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не подходит как имя значения: используйте латинские буквы, цифры и _, и не начинайте с цифры."
          }
        }
      }
    },
    "“%@” couldn’t be changed back" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вернуть файл «%@»"
          }
        }
      }
    },
    "“%@” couldn’t start" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расписание «%@»: не удалось запустить"
          }
        }
      }
    },
    "“%@” didn’t run" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расписание «%@»: запуск пропущен"
          }
        }
      }
    },
    "“%@” failed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расписание «%@»: тесты не прошли"
          }
        }
      }
    },
    "“%@” has changed since “%@”" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%1$@» изменился после действия «%2$@»"
          }
        }
      }
    },
    "“%@” is %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — %@."
          }
        }
      }
    },
    "“%@” is a folder. Attach the files in it instead." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — папка. Прикрепите файлы из неё."
          }
        }
      }
    },
    "“%@” is being recorded now. To go on, JEVision stops recording and adds the steps recorded so far to the test." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас идёт запись теста «%@». Чтобы продолжить, JEVision остановит запись и добавит в тест уже записанные шаги."
          }
        }
      }
    },
    "“%@” is installed" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» установлен"
          }
        }
      }
    },
    "“%@” is paired." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» подключён."
          }
        }
      }
    },
    "“%@” is running now. To go on, JEVision stops it, and the run is kept as stopped." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас идёт тест «%@». Чтобы продолжить, JEVision остановит его, а прогон сохранится как остановленный."
          }
        }
      }
    },
    "“%@” isn’t a port. Mail servers usually use 465 or 587." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не номер порта. Почтовые серверы обычно используют 465 или 587."
          }
        }
      }
    },
    "“%@” isn’t a web address." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” isn’t a web address."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — это не веб-адрес."
          }
        }
      }
    },
    "“%@” isn’t a web address. It should start with http:// or https://." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не веб-адрес. Он должен начинаться с http:// или https://."
          }
        }
      }
    },
    "“%@” isn’t an email address to send from." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не адрес отправителя."
          }
        }
      }
    },
    "“%@” isn’t an email address to send to." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — не адрес получателя."
          }
        }
      }
    },
    "“%@” was changed somewhere else" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» изменили в другом месте"
          }
        }
      }
    },
    "“%@” was created somewhere else" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» создали в другом месте"
          }
        }
      }
    },
    "“%@” was deleted somewhere else" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» удалили в другом месте"
          }
        }
      }
    },
    "“Changes” means the file was saved after the run started." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Изменится» значит, что файл сохранили после начала прогона."
          }
        }
      }
    },
    "“Checks by Meaning” judge a screen from a sentence, with or without a picture. “Writing and Failure Analysis” drafts tests and explains why one failed. Finding an element by its description always uses JEV. A block can name its own AI for a check. The choice is saved in %@ in the project folder, without any key." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Проверки по смыслу» оценивают экран по фразе, с картинкой или без. «Тексты и разбор падений» пишут черновики тестов и объясняют, почему тест упал. Поиск элемента по описанию всегда делает JEV. Блок может назвать свой ИИ для проверки. Выбор сохраняется в %@ в папке проекта, без ключей."
          }
        }
      }
    },
    "“Same as the App” follows the language chosen in Settings → General. Without a time zone, the block tells the time of this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Как в приложении» — язык, выбранный в Настройках → Основные. Без часового пояса блок берёт время этого Mac."
          }
        }
      }
    },
    "…and %lld more" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…и ещё %lld"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
