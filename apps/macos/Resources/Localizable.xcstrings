    "cli.ready.locked" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision can’t run tests: the screen of this Mac is locked.\nUnlock it and run the command again. For runs nobody watches, turn off the automatic\nlock for this user in System Settings → Lock Screen.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision не может запускать тесты: экран этого Mac заблокирован.\nРазблокируйте его и запустите команду снова. Для прогонов без присмотра отключите\nавтоматическую блокировку для этого пользователя в Системных настройках → «Экран блокировки»."
          }
        }
      }
    },
    "cli.ready.noUser" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision can’t run tests here: there is no logged-in user with a screen.\nTests look at windows and click in them, so they run only in the session of a user\nwho is logged in on this Mac: from Terminal, from a CI agent started in that session,\nor over SSH as that same user while they stay logged in. Not as a system service.\nFor runs nobody starts by hand, turn on automatic login in System Settings → Users & Groups.\n"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision не может запускать тесты здесь: нет пользователя, вошедшего в систему с экраном.\nТесты смотрят на окна и кликают в них, поэтому идут только в сеансе пользователя,\nкоторый вошёл в систему на этом Mac: из Терминала, из CI-агента, запущенного в этом сеансе,\nили по SSH под тем же пользователем, пока он остаётся в системе. Не как системная служба.\nДля прогонов, которые никто не запускает вручную, включите автоматический вход\nв Системных настройках → «Пользователи и группы»."
          }
        }
      }
    },
    "cli.ready.notAllowedBoth" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision can’t run tests yet: macOS hasn’t allowed “%@” to record the screen and control the computer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jevision пока не может запускать тесты: macOS не разрешила «%@» записывать экран и управлять компьютером."
          }
        }
      }
    },
    "cli.ready.notAllowedControl" : {
