    },
    "Keep for %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить для «%@»"
          }
        }
      }
    },
    "Keep run videos for" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранить видео прогонов"
          }
        }
      }
    },
    "Keep the Notes on the Canvas" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить заметки на холсте"
          }
        }
      }
    },
    "Keep this Mac awake while remote access is on" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давать Mac засыпать при удалённом доступе"
          }
        }
      }
    },
    "Keeps the selected blocks in the library, to add them to other tests." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет выбранные блоки в библиотеку, чтобы добавлять их в другие тесты."
          }
        }
      }
    },
    "Kept in the Keychain on this Mac, not in the project" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хранится в Связке ключей этого Mac, а не в проекте"
          }
        }
      }
    },
    "Keys" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клавиши"
          }
        }
      }
    },
    "Keys are kept in the Keychain on this Mac. They never get into tests, logs, reports or git." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи хранятся в Связке ключей на этом Mac. В тесты, журналы, отчёты и git они не попадают."
          }
        }
      }
    },
    "Kind of Value" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вид значения"
          }
        }
      }
    },
    "Label" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись"
          }
        }
      }
    },
    "Label of %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись для %@"
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Язык"
          }
        }
      }
    },
    "Large file in a note" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупный файл в заметке"
          }
        }
      }
    },
    "Large files make the project slow to download. Git LFS keeps them out of the project’s history; choosing it adds a line for each file to .gitattributes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупные файлы замедляют загрузку проекта. Git LFS не пускает их в историю проекта; если выбрать его, для каждого файла в .gitattributes добавится строка."
          }
        }
      }
    },
    "Large files make the project slow to download. Install Git LFS, in a project that uses git, to keep them out of its history. You can change what counts as large in Settings." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупные файлы замедляют загрузку проекта. Чтобы не пускать их в историю, установите Git LFS в проекте, который ведётся в git. Что считать крупным, можно изменить в Настройках."
          }
        }
      }
    },
    "Last connected %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последнее подключение %@"
          }
        }
      }
    },
    "Last failed %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последнее падение %@"
          }
        }
      }
    },
    "Last run: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последний прогон: %@"
          }
        }
      }
    },
    "Last step: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последний шаг: %@"
          }
        }
      }
    },
    "Last: %@, %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последнее: %1$@, %2$@"
          }
        }
      }
    },
    "Later" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позже"
          }
        }
      }
    },
    "Later blocks read it as ${var.NAME}. In the format, %@ is the year, %@ the month, %@ the day, %@ the hour, %@ the minute and %@ the second. Names of months and days are in English." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующие блоки читают его как ${var.NAME}. В формате %@ — год, %@ — месяц, %@ — день, %@ — час, %@ — минута, %@ — секунда. Названия месяцев и дней — на английском."
          }
        }
      }
    },
    "Later blocks read it as ${var.NAME}; it’s empty when the clipboard holds no text. The saved text shows in the run’s values, so don’t read the clipboard while it holds something private." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следующие блоки читают его как ${var.NAME}; если в буфере нет текста, значение пустое. Сохранённый текст виден среди значений запуска, поэтому не читайте буфер, пока в нём что-то личное."
          }
        }
      }
    },
    "Latest Runs" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние запуски"
          }
        }
      }
    },
    "Launches an app" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает приложение"
          }
        }
      }
    },
    "Launches an app and brings it to the front." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает приложение и выводит его на передний план."
          }
        }
