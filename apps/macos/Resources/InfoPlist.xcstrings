      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JEVision controls other apps with the AppleScript blocks of your tests, and only when a test says so."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JEVision управляет другими приложениями блоками AppleScript из ваших тестов и только тогда, когда этого требует тест."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JEVision finds your iPhone on the same Wi-Fi, so it can run tests on this Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JEVision находит ваш iPhone в той же сети Wi-Fi, чтобы с него можно было запускать тесты на этом Mac."
