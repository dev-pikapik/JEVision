{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision uses the camera only to read the pairing code your Mac shows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision использует камеру только чтобы прочитать код сопряжения, который показывает Mac."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision uses Face ID to keep your Macs safe: only you can open the app and run tests from it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision использует Face ID, чтобы защитить ваши Mac: открыть приложение и запускать из него тесты можете только вы."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision finds your Mac on this Wi-Fi network to connect to it directly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision ищет ваш Mac в этой сети Wi-Fi, чтобы подключиться к нему напрямую."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "JEVision"
          }
        }
      }
    }
  },
  "version": "1.0"
}
