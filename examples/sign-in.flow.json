{
  "$schema": "https://dev-pikapik.github.io/JEVision/schemas/test.schema.json",
  "format": 1,
  "name": "Sign in with valid credentials",
  "description": "Signs in with a known account and checks that the inbox appears.",
  "app": "com.example.AcmeMail",
  "testType": "smoke",
  "priority": "critical",
  "status": "ready",
  "tags": [
    "sign-in"
  ],
  "preconditions": "AcmeMail is installed and nobody is signed in.",
  "retries": 2,
  "start": "open",
  "blocks": {
    "open": {
      "type": "openApp",
      "next": "email"
    },
    "email": {
      "type": "type",
      "text": "demo@example.com",
      "into": {
        "image": "refs/email-field.png"
      },
      "next": "password"
    },
    "password": {
      "type": "type",
      "text": "${secret.ACME_PASSWORD}",
      "into": {
        "image": "refs/password-field.png"
      },
      "next": "submit"
    },
    "submit": {
      "type": "click",
      "target": {
        "image": "refs/sign-in-button.png"
      },
      "button": "left",
      "next": "inbox"
    },
    "inbox": {
      "type": "waitFor",
      "until": {
        "appears": {
          "image": "refs/inbox.png",
          "compare": "similar",
          "threshold": 0.95
        }
      },
      "timeout": "10s",
      "next": "messages"
    },
    "messages": {
      "type": "check",
      "reference": {
        "image": "refs/message-list.png",
        "compare": "similar",
        "threshold": 0.9,
        "ignore": [
          {
            "x": 0.8,
            "y": 0.0,
            "width": 0.2,
            "height": 0.1
          }
        ],
        "hide": [
          {
            "x": 0.0,
            "y": 0.0,
            "width": 0.3,
            "height": 0.1
          }
        ]
      }
    }
  }
}
