{
  "$schema": "https://dev-pikapik.github.io/JEVision/schemas/test.schema.json",
  "format": 1,
  "name": "Add a line to a note",
  "description": "Opens a copy of note.txt in TextEdit, adds a line at the end, checks how the window looks and quits TextEdit.",
  "app": "com.apple.TextEdit",
  "testType": "smoke",
  "priority": "medium",
  "status": "ready",
  "tags": [
    "example"
  ],
  "start": "open",
  "blocks": {
    "open": {
      "type": "openFile",
      "files": [
        "note.txt"
      ],
      "app": "com.apple.TextEdit",
      "next": "end"
    },
    "end": {
      "type": "pressKeys",
      "keys": "cmd+down",
      "next": "type"
    },
    "type": {
      "type": "type",
      "text": "- milk\n",
      "next": "check"
    },
    "check": {
      "type": "check",
      "reference": {
        "image": "refs/note.png",
        "compare": "similar",
        "threshold": 0.95
      },
      "next": "quit"
    },
    "quit": {
      "type": "pressKeys",
      "keys": "cmd+q"
    }
  }
}
