{
  "$schema": "https://dev-pikapik.github.io/JEVision/schemas/test.schema.json",
  "format": 1,
  "name": "Explore",
  "description": "Opens an empty project, checks the New Test and Settings windows, and cancels the new test without creating a file.",
  "app": "io.github.dev-pikapik.jevision",
  "testType": "acceptance",
  "priority": "high",
  "status": "ready",
  "tags": [
    "selftest"
  ],
  "start": "start",
  "blocks": {
    "start": {
      "type": "runTest",
      "test": "blocks/start-jevision.block.json",
      "inputs": {
        "onboardingDone": "YES",
        "profile": "explore"
      },
      "next": "home"
    },
    "home": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "main.openProject",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "prepareFolder"
    },
    "prepareFolder": {
      "type": "script",
      "language": "sh",
      "code": "mkdir -p \"$FOLDER\"",
      "inputs": [
        {
          "name": "FOLDER",
          "value": "${env.SELFTEST_WORK}/projects/explore"
        }
      ],
      "timeout": "10s",
      "next": "openProject"
    },
    "openProject": {
      "type": "click",
      "target": {
        "element": {
          "id": "main.openProject"
        }
      },
      "button": "left",
      "next": "folderPanel"
    },
    "folderPanel": {
      "type": "waitFor",
      "until": {
        "element": {
          "role": "button",
          "title": "Open",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "goToFolder"
    },
    "goToFolder": {
      "type": "pressKeys",
      "keys": "cmd+shift+g",
      "next": "folderPath"
    },
    "folderPath": {
      "type": "type",
      "text": "${env.SELFTEST_WORK}/projects/explore",
      "next": "confirmFolder"
    },
    "confirmFolder": {
      "type": "pressKeys",
      "keys": "return",
      "next": "folderReady"
    },
    "folderReady": {
      "type": "waitFor",
      "until": {
        "element": {
          "role": "button",
          "title": "Open",
          "is": "enabled"
        }
      },
      "timeout": "15s",
      "next": "chooseFolder"
    },
    "chooseFolder": {
      "type": "pressKeys",
      "keys": "return",
      "next": "emptyProject"
    },
    "emptyProject": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "project.newTest",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "newTest"
    },
    "newTest": {
      "type": "click",
      "target": {
        "element": {
          "id": "project.newTest"
        }
      },
      "button": "left",
      "next": "newTestSheet"
    },
    "newTestSheet": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "newTest.name",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "canCancel"
    },
    "canCancel": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "newTest.cancel",
          "is": "enabled"
        }
      },
      "timeout": "15s",
      "next": "cancelTest"
    },
    "cancelTest": {
      "type": "click",
      "target": {
        "element": {
          "id": "newTest.cancel"
        }
      },
      "button": "left",
      "next": "backToProject"
    },
    "backToProject": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "project.newTest",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "settings"
    },
    "settings": {
      "type": "pressKeys",
      "keys": "cmd+,",
      "next": "language"
    },
    "language": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "settings.language",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "closeSettings"
    },
    "closeSettings": {
      "type": "pressKeys",
      "keys": "cmd+w",
      "next": "projectAgain"
    },
    "projectAgain": {
      "type": "waitFor",
      "until": {
        "element": {
          "id": "project.newTest",
          "is": "present"
        }
      },
      "timeout": "15s",
      "next": "quit"
    },
    "quit": {
      "type": "pressKeys",
      "keys": "cmd+q"
    }
  }
}
